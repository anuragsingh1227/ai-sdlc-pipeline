{
  "name": "ai-sdlc-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Control-plane playbook and validator for a file-handoff AI SDLC pipeline.",
  "type": "module",
  "bin": {
    "pipeline": "src/cli.ts"
  },
  "scripts": {
    "pipeline": "tsx src/cli.ts",
    "validate": "tsx src/cli.ts validate && tsx src/cli.ts validate --run examples/sample-run",
    "status": "tsx src/cli.ts status --run examples/sample-run",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
