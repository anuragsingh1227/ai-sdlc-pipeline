# Copy to .env and fill in locally. Never commit real tokens.
# CI and `npm test` use --mock / PIPELINE_MOCK_ATLASSIAN=1 and do not read this file.

# Confluence Cloud. Base URL may be the site or the /wiki root.
CONFLUENCE_BASE_URL=https://example.atlassian.net/wiki
CONFLUENCE_EMAIL=you@example.com
CONFLUENCE_API_TOKEN=
CONFLUENCE_PAGE_ID=

# Jira Cloud. API token auth is Basic email:token against /rest/api/3.
JIRA_BASE_URL=https://example.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=OPS

# Set to 1 to read examples/fixtures instead of calling Atlassian.
# PIPELINE_MOCK_ATLASSIAN=1

# Where merge requests are opened. github or gitlab.
GIT_HOST=github
